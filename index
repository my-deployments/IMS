  var IC_ADMIN = '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94L14.4 2.81c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41L9.25 5.35C8.66 5.59 8.12 5.92 7.63 6.29L5.24 5.33c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58C4.84 11.36 4.8 11.69 4.8 12s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.03-1.58zM12 15.6a3.6 3.6 0 1 1 0-7.2a3.6 3.6 0 0 1 0 7.2z"/></svg>';
  var IC_CRM = '<svg viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="8" r="3.4"/><path d="M5 20a7 7 0 0 1 14 0z"/></svg>';
  var IC_IMS = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 20v-9l7-5l7 5v9"/><path d="M10 20v-5h4v5"/></svg>';

  /* Nhóm + module. color lấy từ ModuleSelect.md (accent-4/7/8/5/9/10). */
  var PRODUCT_GROUPS = [
    {
      name: 'Vận hành', open: true,
      items: [
        { key: 'pms',   name: 'ezOne.Pms',     desc: 'Property management system',  color: '#345B82', icon: IC_PMS },
        { key: 'crs',   name: 'ezOne.Crs',     desc: 'Center reservation system',   color: '#00A8DA', icon: IC_CRS },
        { key: 'msg',   name: 'ezOne.Message', desc: 'Guest messaging platforms',   color: '#00AA74', icon: IC_MSG },
        { key: 'admin', name: 'ezOne.Admin',   desc: 'Administration system',       color: '#8A9BB2', icon: IC_ADMIN },
        { key: 'crm',   name: 'ezOne.Crm',     desc: 'Customer Relationship Management', color: '#2E4A60', icon: IC_CRM },
        { key: 'ims',   name: 'ezOne.Ims',     desc: 'Integrated Management System', color: '#6E5040', icon: IC_IMS }
      ]
    },
    { name: 'Backoffice', open: false, items: [] },
    { name: 'Module Placeholder', open: false, items: [] }
  ];

  var IC_CHEVRON = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6l6 -6"/></svg>';

  function renderProducts(query) {
    var q = (query || '').trim().toLowerCase();
    var html = PRODUCT_GROUPS.map(function (g, gi) {
      var items = g.items.filter(function (it) {
        return !q || it.name.toLowerCase().indexOf(q) > -1 || it.desc.toLowerCase().indexOf(q) > -1;
      });
      /* Đang tìm kiếm thì mở hết nhóm có kết quả */
      var closed = q ? items.length === 0 : !g.open;
      return '<section class="prod-group' + (closed ? ' is-closed' : '') + '" data-gi="' + gi + '">' +
          '<button class="prod-g-head" type="button" aria-expanded="' + (!closed) + '">' +
            '<span class="prod-caret" aria-hidden="true">' + IC_CHEVRON + '</span>' + esc(g.name) +
          '</button>' +
          (items.length
            ? '<div class="prod-grid">' + items.map(function (it) {
                return '<button class="prod-item" type="button" data-prod="' + it.key + '" aria-label="Mở ' + esc(it.name) + '">' +
                  '<span class="prod-ico" style="background:' + it.color + '" aria-hidden="true">' + it.icon + '</span>' +
                  '<span class="prod-name">' + esc(it.name) + '</span>' +
                  '<span class="prod-desc">' + esc(it.desc) + '</span>' +
                '</button>';
              }).join('') + '</div>'
            : (q ? '' : '<div class="prod-grid"></div>')) +
        '</section>';
    }).join('');

    var anyItem = PRODUCT_GROUPS.some(function (g) {
      return g.items.some(function (it) {
        return !q || it.name.toLowerCase().indexOf(q) > -1 || it.desc.toLowerCase().indexOf(q) > -1;
      });
    });
    $('prodBody').innerHTML = anyItem ? html : '<div class="prod-empty">Không có dữ liệu</div>';

    $('prodBody').querySelectorAll('.prod-g-head').forEach(function (h) {
      h.addEventListener('click', function () {
        var sec = h.closest('.prod-group');
        var closed = sec.classList.toggle('is-closed');
        h.setAttribute('aria-expanded', String(!closed));
        PRODUCT_GROUPS[Number(sec.getAttribute('data-gi'))].open = !closed;
      });
    });
    $('prodBody').querySelectorAll('[data-prod]').forEach(function (b) {
      b.addEventListener('click', function () { pickProduct(b.getAttribute('data-prod')); });
    });
  }

  function pickProduct(key) {
    if (key === 'ims') { closeLayer('modalProducts'); toast('Bạn đang ở ezOne.Ims'); return; }
    if (key === 'admin') {
      closeLayer('modalProducts');
      /* Chuyển sang ezOne.Admin ở cửa sổ mới */
      var w = window.open(ADMIN_URL, '_blank');
      if (!w) toast('Trình duyệt đã chặn cửa sổ mới, vui lòng cho phép pop-up', 'error');
      return;
    }
    toast('Module này chưa được triển khai', 'error');
  }

  /* Neo popover ngay dưới nút Ứng dụng, canh mép phải theo nút */
  function positionProducts() {
    var el = $('modalProducts');
    if (!el.classList.contains('is-open')) return;
    var r = $('btnApps').getBoundingClientRect();
    var w = el.offsetWidth;
    var left = Math.min(r.right - w, window.innerWidth - w - 8);
    el.style.left = Math.max(8, left) + 'px';
    el.style.top = (r.bottom + 8) + 'px';
    el.style.right = 'auto';
    el.style.bottom = 'auto';
  }

  $('btnApps').addEventListener('click', function () {
    if ($('modalProducts').classList.contains('is-open')) { closeLayer('modalProducts'); return; }
    $('prodSearch').value = '';
    renderProducts('');
    openLayer('modalProducts');
    $('backdrop').classList.add('is-clear');   /* popover: không làm tối nền */
    positionProducts();
    $('btnApps').setAttribute('aria-expanded', 'true');
    $('prodSearch').focus();
  });
  $('prodSearch').addEventListener('input', function () { renderProducts(this.value); });
  window.addEventListener('resize', positionProducts);
  window.addEventListener('scroll', positionProducts, true);

  /* ============================================================
     MODAL XÁC NHẬN NGỪNG HOẠT ĐỘNG (toggle ON -> OFF)
     ============================================================ */
  var pendingSwitch = null;
  function askDeactivate(switchEl, kindLabel) {
    pendingSwitch = switchEl;
    $('mdaBody').textContent = kindLabel + ' này sẽ không hiển thị trên phần thiết lập khách sạn';
    $('modalDeactivate').classList.add('is-open');
    $('backdrop').classList.add('is-open');
    openStack.push('modalDeactivate');
    $('btnConfirmDeactivate').focus();
  }
  $('btnConfirmDeactivate').addEventListener('click', function () {
    if (!pendingSwitch) { closeLayer('modalDeactivate'); return; }
    pendingSwitch.setAttribute('aria-checked', 'false');

    /* Áp dụng NGAY vào dữ liệu (nếu đang sửa bản ghi đã tồn tại)
       -> báo thành công lập tức + Admin ẩn nhóm/bước tương ứng. */
    var applied = false;
    if (pendingSwitch.id === 'gActive' && st.groupEditIdx > -1) {
      DATA[st.groupEditIdx].active = false;
      if (st.detailIdx === st.groupEditIdx) fillDetailHead();
      renderGroups();
      applied = true;
    } else if (pendingSwitch.id === 'sActive' && st.stepEditIdx > -1 && st.detailIdx > -1) {
      DATA[st.detailIdx].steps[st.stepEditIdx].active = false;
      renderSteps();
      applied = true;
    }

    pendingSwitch = null;
    closeLayer('modalDeactivate');
    if (applied) { publishToAdmin(); toast('Cập nhật thành công'); }
  });
  function cancelDeactivate() { pendingSwitch = null; closeLayer('modalDeactivate'); }
  $('btnCancelDeactivate').addEventListener('click', cancelDeactivate);

  /* ============================================================
     VALIDATE
     ============================================================ */
  var RE_CODE_OK = /^[A-Z0-9._-]+$/;
  var RE_PATH_OK = /^[a-zA-Z0-9/_-]+$/;

  function setErr(inputId, errId, msg) {
    $(inputId).classList.toggle('is-error', !!msg);
    $(errId).textContent = msg || '';
    return !msg;
  }
  function validCode(val, inputId, errId, existing) {
    var v = val.trim();
    if (!v) return setErr(inputId, errId, 'Không được để trống');
    if (v.length > 50) return setErr(inputId, errId, 'Tối đa 50 ký tự');
    if (!RE_CODE_OK.test(v)) return setErr(inputId, errId, 'Không được sử dụng ký tự đặc biệt');
    if (existing.indexOf(v) > -1) return setErr(inputId, errId, 'Mã đã tồn tại');
    return setErr(inputId, errId, '');
  }
  function validName(val, inputId, errId) {
    var v = val.trim();
    if (!v) return setErr(inputId, errId, 'Không được để trống');
    if (val.length > 300) return setErr(inputId, errId, 'Tối đa 300 ký tự');
    return setErr(inputId, errId, '');
  }

  /* Mã: tự uppercase + chặn khoảng trắng */
  function bindCodeInput(id) {
    $(id).addEventListener('input', function () {
      var p = this.selectionStart;
      this.value = this.value.toUpperCase().replace(/\s+/g, '');
      this.setSelectionRange(p, p);
    });
  }
  bindCodeInput('gCode'); bindCodeInput('sCode');
  $('sPath').addEventListener('input', function () { this.value = this.value.replace(/\s+/g, ''); });

  /* ============================================================
     DRAWER NHÓM THIẾT LẬP
     ============================================================ */
  function openGroupDrawer(idx) {
    st.groupEditIdx = idx;
    var isEdit = idx > -1;
    $('dgTitle').textContent = isEdit ? 'Chỉnh sửa nhóm thiết lập' : 'Thêm mới nhóm thiết lập';
    $('gCode').value = isEdit ? DATA[idx].code : '';
    $('gName').value = isEdit ? DATA[idx].name : '';
    $('gActive').setAttribute('aria-checked', String(isEdit ? DATA[idx].active : true));
    setErr('gCode', 'errGCode', ''); setErr('gName', 'errGName', '');
    openLayer('drawerGroup');
  }
  $('btnAddGroup').addEventListener('click', function () { openGroupDrawer(-1); });
  $('btnEditFromDetail').addEventListener('click', function () { openGroupDrawer(st.detailIdx); });

  $('btnSaveGroup').addEventListener('click', function () {
    var others = DATA.filter(function (_, i) { return i !== st.groupEditIdx; }).map(function (g) { return g.code; });
    var ok1 = validCode($('gCode').value, 'gCode', 'errGCode', others);
    var ok2 = validName($('gName').value, 'gName', 'errGName');
    if (!ok1 || !ok2) return;

    var payload = {
      code: $('gCode').value.trim(),
      name: $('gName').value.trim(),
      active: $('gActive').getAttribute('aria-checked') === 'true'
    };
    if (st.groupEditIdx > -1) {
      DATA[st.groupEditIdx].code = payload.code;
      DATA[st.groupEditIdx].name = payload.name;
      DATA[st.groupEditIdx].active = payload.active;
      if (st.detailIdx === st.groupEditIdx) fillDetailHead();
      toast('Cập nhật thành công');
    } else {
      payload.steps = [];
      DATA.push(payload);
      toast('Thêm mới thành công');
    }
    closeLayer('drawerGroup');
    renderGroups();
    publishToAdmin();      /* đổi tên / trạng thái nhóm -> Admin cập nhật theo */
  });

  /* ============================================================
     DRAWER CHI TIẾT NHÓM
     ============================================================ */
  function fillDetailHead() {
    var g = DATA[st.detailIdx];
    $('ddCode').textContent = g.code;
    $('ddName').textContent = g.name;
    $('ddStatus').innerHTML = badge(g.active);
  }
  function openDetail(idx) {
    st.detailIdx = idx; st.pgS = 1;
    fillDetailHead();
    renderSteps();
    openLayer('drawerDetail');
  }

  /* ============================================================
     DRAWER BƯỚC THIẾT LẬP — select-field Dịch vụ / Chức năng liên động
     ============================================================ */
  var sel = { svc: '', fn: '' };

  /* Đổ option Dịch vụ. Giá trị ngừng hoạt động -> disabled (SRS). */
  function fillServiceSelect() {
    var cur = sel.svc;
    $('sService').innerHTML = '<option value="">Chọn dịch vụ</option>' +
      SERVICES.map(function (s) {
        return '<option value="' + s.code + '"' + (s.active ? '' : ' disabled') + (s.code === cur ? ' selected' : '') + '>' +
          esc(s.code + ' - ' + s.name) + '</option>';
      }).join('');
  }

  /* Đổ option Chức năng — lọc theo Dịch vụ đang chọn; chưa chọn thì hiện tất cả. */
  function fillFunctionSelect() {
    var cur = sel.fn;
    var list = FUNCTIONS.filter(function (f) { return !sel.svc || f.svc === sel.svc; });
    $('sFunction').innerHTML = '<option value="">Chọn chức năng</option>' +
      list.map(function (f) {
        return '<option value="' + f.code + '"' + (f.code === cur ? ' selected' : '') + '>' +
          esc(f.code + ' - ' + f.name) + '</option>';
      }).join('');
    if (cur && !list.some(function (f) { return f.code === cur; })) { sel.fn = ''; $('sFunction').value = ''; }
  }

  /* Chọn Dịch vụ trước -> Chức năng chỉ còn của Dịch vụ đó */
  $('sService').addEventListener('change', function () {
    sel.svc = this.value;
    setErr('sService', 'errSService', '');
    fillFunctionSelect();
  });

  /* Chọn Chức năng trước -> tự xác định & điền Dịch vụ tương ứng */
  $('sFunction').addEventListener('change', function () {
    sel.fn = this.value;
    setErr('sFunction', 'errSFunction', '');
    var f = FUNCTIONS.filter(function (x) { return x.code === sel.fn; })[0];
    if (!f) return;
    if (sel.svc !== f.svc) {
      sel.svc = f.svc;
      fillServiceSelect();
      setErr('sService', 'errSService', '');
    }
    /* Tự fill Mã + Tên bước thiết lập từ Chức năng */
    if (!$('sCode').value.trim()) $('sCode').value = f.code;
    if (!$('sName').value.trim()) $('sName').value = f.name;
  });

  $('sCond').addEventListener('change', function () {
    $('fieldMinQty').hidden = this.value !== 'exists';
    setErr('sCond', 'errSCond', '');
  });
  $('minUp').addEventListener('click', function () { $('sMinQty').value = Number($('sMinQty').value || 0) + 1; });
  $('minDown').addEventListener('click', function () { $('sMinQty').value = Math.max(0, Number($('sMinQty').value || 0) - 1); });

  function openStepDrawer(idx) {
    st.stepEditIdx = idx;
    var isEdit = idx > -1;
    var s = isEdit ? DATA[st.detailIdx].steps[idx] : null;
    $('dsTitle').textContent = isEdit ? 'Chỉnh sửa bước thiết lập' : 'Thêm mới bước thiết lập';

    sel.svc = isEdit ? s.svc : '';
    var fnObj = isEdit ? FUNCTIONS.filter(function (x) { return x.name === s.fn; })[0] : null;
    sel.fn = fnObj ? fnObj.code : '';
    fillServiceSelect();
    fillFunctionSelect();
    $('sCode').value = isEdit ? s.code : '';
    $('sName').value = isEdit ? s.name : '';
    $('sPath').value = isEdit ? s.path : '';
    $('sCond').value = isEdit ? s.cond : '';
    $('fieldMinQty').hidden = !(isEdit && s.cond === 'exists');
    $('sMinQty').value = isEdit && s.min != null ? s.min : 1;
    $('sDesc').value = isEdit ? s.desc : '';
    $('sActive').setAttribute('aria-checked', String(isEdit ? s.active : true));

    ['sService','sFunction','sCode','sName','sPath','sCond','sMinQty','sDesc'].forEach(function (id) {
      var e = $('err' + id.charAt(0).toUpperCase() + id.slice(1));
      if (e) { e.textContent = ''; $(id).classList.remove('is-error'); }
    });
    openLayer('drawerStep', 'md');
  }
  $('btnAddStep').addEventListener('click', function () { openStepDrawer(-1); });

  $('btnSaveStep').addEventListener('click', function () {
    var g = DATA[st.detailIdx];
    var ok = true;

    if (!$('sService').value) { setErr('sService', 'errSService', 'Không được để trống'); ok = false; } else setErr('sService', 'errSService', '');
    if (!$('sFunction').value) { setErr('sFunction', 'errSFunction', 'Không được để trống'); ok = false; } else setErr('sFunction', 'errSFunction', '');

    var otherCodes = [];
    DATA.forEach(function (gr, gi) {
      gr.steps.forEach(function (s, si) {
        if (!(gi === st.detailIdx && si === st.stepEditIdx)) otherCodes.push(s.code);
      });
    });
    if (!validCode($('sCode').value, 'sCode', 'errSCode', otherCodes)) ok = false;
    if (!validName($('sName').value, 'sName', 'errSName')) ok = false;

    var path = $('sPath').value.trim();
    if (path.length > 300) { setErr('sPath', 'errSPath', 'Tối đa 300 ký tự'); ok = false; }
    else if (path && !RE_PATH_OK.test(path)) { setErr('sPath', 'errSPath', 'Đường dẫn chứa ký tự không hợp lệ'); ok = false; }
    else setErr('sPath', 'errSPath', '');

    if (!$('sCond').value) { setErr('sCond', 'errSCond', 'Không được để trống'); ok = false; } else setErr('sCond', 'errSCond', '');
    if ($('sDesc').value.length > 300) { setErr('sDesc', 'errSDesc', 'Tối đa 300 ký tự'); ok = false; } else setErr('sDesc', 'errSDesc', '');
    if (!ok) return;

    var fnPicked = FUNCTIONS.filter(function (x) { return x.code === $('sFunction').value; })[0];
    var payload = {
      svc: $('sService').value, fn: fnPicked ? fnPicked.name : '',
      code: $('sCode').value.trim(), name: $('sName').value.trim(),
      path: path, cond: $('sCond').value,
      min: $('sCond').value === 'exists' ? Number($('sMinQty').value || 0) : null,
      desc: $('sDesc').value.trim(),
      active: $('sActive').getAttribute('aria-checked') === 'true'
    };
    if (st.stepEditIdx > -1) { g.steps[st.stepEditIdx] = payload; toast('Cập nhật thành công'); }
    else { g.steps.push(payload); toast('Thêm mới thành công'); }
    closeLayer('drawerStep');
    renderSteps();
    publishToAdmin();      /* đổi tên / trạng thái bước -> Admin cập nhật theo */
  });

  /* ============================================================
     CỘT HIỂN THỊ
     ============================================================ */
  function openCols(target) {
    st.colsTarget = target;
    var src = target === 'group' ? COLS_GROUP : COLS_STEP;
    st.colsDraft = src.map(function (c) { return { key: c.key, on: c.on }; });
    $('colsGrid').innerHTML = src.map(function (c, i) {
      return '<label class="chk-row' + (c.locked ? ' is-locked' : '') + '">' +
        '<input type="checkbox" data-ci="' + i + '"' + (c.on ? ' checked' : '') + (c.locked ? ' disabled' : '') + ' />' +
        '<span>' + esc(c.label) + '</span></label>';
    }).join('');
    $('colsGrid').querySelectorAll('input[data-ci]').forEach(function (chk) {
      chk.addEventListener('change', function () { st.colsDraft[Number(chk.getAttribute('data-ci'))].on = chk.checked; });
    });
    openLayer('drawerCols');
  }
  $('btnColsGroup').addEventListener('click', function () { openCols('group'); });
  $('btnColsStep').addEventListener('click', function () { openCols('step'); });
  $('btnColsApply').addEventListener('click', function () {
    var target = st.colsTarget === 'group' ? COLS_GROUP : COLS_STEP;
    st.colsDraft.forEach(function (d, i) { if (!target[i].locked) target[i].on = d.on; });
    closeLayer('drawerCols');
    st.colsTarget === 'group' ? renderGroups() : renderSteps();
    toast('Áp dụng cấu hình cột thành công');
  });
  $('btnColsReset').addEventListener('click', function () {
    var def = st.colsTarget === 'group'
      ? { stt: true, code: true, name: true, status: true, action: true }
      : { stt: true, svc: true, fn: true, code: true, name: true, path: false, cond: true, desc: false, status: true, action: true };
    var target = st.colsTarget === 'group' ? COLS_GROUP : COLS_STEP;
    target.forEach(function (c) { c.on = def[c.key]; });
    openCols(st.colsTarget);
  });

  /* ============================================================
     XÓA
     ============================================================ */
  function askDelete(kind, idx) {
    st.delKind = kind; st.delIdx = idx;
    $('mdBody').textContent = kind === 'group'
      ? 'Bạn có chắc chắn muốn xóa nhóm thiết lập này ?'
      : 'Bạn có chắc chắn muốn xóa bước thiết lập này ?';
    $('modalDelete').classList.add('is-open');
    $('backdrop').classList.add('is-open');
    openStack.push('modalDelete');
    $('btnConfirmDelete').focus();
  }
  $('btnConfirmDelete').addEventListener('click', function () {
    if (st.delKind === 'group') {
      DATA.splice(st.delIdx, 1);
      if (st.detailIdx === st.delIdx) { closeLayer('drawerDetail'); st.detailIdx = -1; }
      renderGroups();
    } else {
      DATA[st.detailIdx].steps.splice(st.delIdx, 1);
      renderSteps();
    }
    closeLayer('modalDelete');
    publishToAdmin();      /* xóa nhóm/bước -> biến mất khỏi thanh tiến độ Admin */
    toast('Xóa thành công');
  });

  /* ============================================================
     SỰ KIỆN BẢNG (event delegation)
     ============================================================ */
  $('tbGroups').addEventListener('click', function (e) {
    var ed = e.target.closest('[data-edit-group]');
    if (ed) { e.stopPropagation(); openGroupDrawer(Number(ed.getAttribute('data-edit-group'))); return; }
    var dl = e.target.closest('[data-del-group]');
    if (dl) { e.stopPropagation(); askDelete('group', Number(dl.getAttribute('data-del-group'))); return; }
    var row = e.target.closest('[data-row-group]');
    if (row && !e.target.closest('.drag-cell')) openDetail(Number(row.getAttribute('data-row-group')));
  });
  $('tbGroups').addEventListener('keydown', function (e) {
    var row = e.target.closest('[data-row-group]');
    if (row && (e.key === 'Enter' || e.key === ' ')) { e.preventDefault(); openDetail(Number(row.getAttribute('data-row-group'))); }
  });
  $('tbSteps').addEventListener('click', function (e) {
    var ed = e.target.closest('[data-edit-step]');
    if (ed) { openStepDrawer(Number(ed.getAttribute('data-edit-step'))); return; }
    var dl = e.target.closest('[data-del-step]');
    if (dl) askDelete('step', Number(dl.getAttribute('data-del-step')));
  });

  /* -------------------- Bộ lọc + phân trang -------------------- */
  $('btnSearch').addEventListener('click', function () {
    st.filterText = $('fSearch').value;
    st.filterStatus = $('fStatus').value;
    st.pgG = 1;
    renderGroups();
  });
  $('fSearch').addEventListener('keydown', function (e) { if (e.key === 'Enter') $('btnSearch').click(); });
  $('pgSizeG').addEventListener('change', function () { st.sizeG = Number(this.value); st.pgG = 1; renderGroups(); });
  $('pgSizeS').addEventListener('change', function () { st.sizeS = Number(this.value); st.pgS = 1; renderSteps(); });

  /* -------------------- Toggle trạng thái hoạt động --------------------
     Bật -> tắt: phải xác nhận qua modal "Xác nhận Ngừng hoạt động".
     Tắt -> bật: đổi ngay, không cần hỏi. */
  var SWITCH_LABEL = { gActive: 'Nhóm thiết lập', sActive: 'Bước thiết lập' };
  document.querySelectorAll('.switch').forEach(function (sw) {
    sw.addEventListener('click', function () {
      var isOn = sw.getAttribute('aria-checked') === 'true';
      if (isOn) askDeactivate(sw, SWITCH_LABEL[sw.id] || 'Bản ghi');
      else sw.setAttribute('aria-checked', 'true');
    });
  });

  /* -------------------- Icon song ngữ (Figma "Two Languages" 0:6153) --------------------
     3 icon 15×15: Ngôn ngữ mặc định (địa cầu) · Cờ Việt Nam · Cờ Anh */
  var FLAG_DEFAULT =
    '<svg viewBox="0 0 15 15" xmlns="http://www.w3.org/2000/svg">' +
      '<circle cx="7.5" cy="7.5" r="7" fill="#1A73E8"/>' +
      '<path d="M.5 7.5h14M7.5.5a11 11 0 0 1 0 14M7.5.5a11 11 0 0 0 0 14" fill="none" stroke="#fff" stroke-width="1"/>' +
    '</svg>';
  var FLAG_VN =
    '<svg viewBox="0 0 15 15" xmlns="http://www.w3.org/2000/svg">' +
      '<rect y="2.586" width="15" height="9.828" rx="1" fill="#DA251D"/>' +
      '<path d="M7.5 4.35l.83 2.55h2.68l-2.17 1.58.83 2.55-2.17-1.58-2.17 1.58.83-2.55L3.99 6.9h2.68z" fill="#FFFF00"/>' +
    '</svg>';
  var FLAG_EN =
    '<svg viewBox="0 0 15 15" xmlns="http://www.w3.org/2000/svg">' +
      '<clipPath id="ukClip"><rect y="2.586" width="15" height="9.828" rx="1"/></clipPath>' +
      '<g clip-path="url(#ukClip)">' +
        '<rect y="2.586" width="15" height="9.828" fill="#012169"/>' +
        '<path d="M0 2.586L15 12.414M15 2.586L0 12.414" stroke="#FFF" stroke-width="2"/>' +
        '<path d="M0 2.586L15 12.414M15 2.586L0 12.414" stroke="#C8102E" stroke-width="1"/>' +
        '<path d="M7.5 2.586v9.828M0 7.5h15" stroke="#FFF" stroke-width="3"/>' +
        '<path d="M7.5 2.586v9.828M0 7.5h15" stroke="#C8102E" stroke-width="1.8"/>' +
      '</g>' +
    '</svg>';
  var LANGS = [
    { k: 'def', t: 'Ngôn ngữ mặc định', svg: FLAG_DEFAULT },
    { k: 'vi',  t: 'Tiếng Việt',        svg: FLAG_VN },
    { k: 'en',  t: 'Tiếng Anh',         svg: FLAG_EN }
  ];
  document.querySelectorAll('.lang-flags').forEach(function (box) {
    box.innerHTML = LANGS.map(function (l, i) {
      return '<button class="lang-flag' + (i === 0 ? ' is-on' : '') + '" type="button" data-lang="' + l.k +
        '" title="' + l.t + '" aria-label="' + l.t + '" aria-pressed="' + (i === 0) + '">' + l.svg + '</button>';
    }).join('');
    box.querySelectorAll('.lang-flag').forEach(function (b) {
      b.addEventListener('click', function () {
        box.querySelectorAll('.lang-flag').forEach(function (x) { x.classList.remove('is-on'); x.setAttribute('aria-pressed', 'false'); });
        b.classList.add('is-on');
        b.setAttribute('aria-pressed', 'true');
      });
    });
  });

  /* -------------------- App-shell: pin / caret / chọn mục -------------------- */
  var app = $('app');
  function toggleCollapse() {
    var c = app.classList.toggle('is-collapsed');
    $('logoBtn').setAttribute('aria-label', c ? 'Mở rộng menu' : 'Menu');
    $('pinBtn').setAttribute('aria-label', c ? 'Ghim menu' : 'Bỏ ghim / thu gọn menu');
  }
  $('pinBtn').addEventListener('click', toggleCollapse);
  $('logoBtn').addEventListener('click', function () { if (app.classList.contains('is-collapsed')) toggleCollapse(); });
  document.querySelectorAll('.nav-caret').forEach(function (caret) {
    caret.addEventListener('click', function (e) {
      e.stopPropagation();
      if (app.classList.contains('is-collapsed')) return;
      var closed = caret.closest('.nav-group').classList.toggle('is-closed');
      caret.setAttribute('aria-expanded', String(!closed));
    });
  });
  document.querySelectorAll('.nav-child').forEach(function (el) {
    el.addEventListener('click', function () {
      document.querySelectorAll('.nav-child.is-selected').forEach(function (s) { s.classList.remove('is-selected'); s.removeAttribute('aria-current'); });
      el.classList.add('is-selected');
      el.setAttribute('aria-current', 'page');
    });
    el.addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); el.click(); } });
  });

  /* -------------------- Khởi tạo -------------------- */
  renderGroups();
  publishToAdmin();   /* đẩy trạng thái hiện tại để Admin mở sau vẫn đúng */
})();
</script>
</body>
</html>
