      next:  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6l-6 6"/></svg>',
      last:  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 7l5 5l-5 5"/><path d="M13 7l5 5l-5 5"/></svg>'
    };
    var h = '';
    h += '<button class="pg-btn" type="button" data-go="1" ' + (cur === 1 ? 'disabled' : '') + ' aria-label="Trang đầu tiên">' + IC.first + '</button>';
    h += '<button class="pg-btn" type="button" data-go="' + (cur - 1) + '" ' + (cur === 1 ? 'disabled' : '') + ' aria-label="Trang trước">' + IC.prev + '</button>';
    for (var p = 1; p <= max; p++) {
      if (max > 6 && p > 2 && p < max - 1 && Math.abs(p - cur) > 1) {
        if (h.indexOf('data-ellipsis') === -1) h += '<span class="pg-text" data-ellipsis>…</span>';
        continue;
      }
      h += '<button class="pg-btn' + (p === cur ? ' is-active' : '') + '" type="button" data-go="' + p + '" aria-label="Trang ' + p + '"' + (p === cur ? ' aria-current="page"' : '') + '>' + p + '</button>';
    }
    h += '<button class="pg-btn" type="button" data-go="' + (cur + 1) + '" ' + (cur === max ? 'disabled' : '') + ' aria-label="Trang sau">' + IC.next + '</button>';
    h += '<button class="pg-btn" type="button" data-go="' + max + '" ' + (cur === max ? 'disabled' : '') + ' aria-label="Trang cuối cùng">' + IC.last + '</button>';
    box.innerHTML = h;
    box.querySelectorAll('[data-go]').forEach(function (b) {
      b.addEventListener('click', function () { go(Number(b.getAttribute('data-go'))); });
    });
  }

  /* -------------------- Kéo-thả đổi thứ tự (HTML5 thuần) -------------------- */
  function bindDrag(tbody, arr, rerender) {
    var dragFrom = null;
    tbody.querySelectorAll('.drag-cell[draggable]').forEach(function (cell) {
      var tr = cell.parentElement;
      cell.addEventListener('dragstart', function (e) {
        dragFrom = Array.prototype.indexOf.call(tbody.children, tr);
        tr.classList.add('is-dragging');
        e.dataTransfer.effectAllowed = 'move';
        try { e.dataTransfer.setData('text/plain', String(dragFrom)); } catch (err) {}
      });
      cell.addEventListener('dragend', function () {
        tr.classList.remove('is-dragging');
        tbody.querySelectorAll('.drop-target').forEach(function (r) { r.classList.remove('drop-target'); });
      });
    });
    tbody.querySelectorAll('tr').forEach(function (tr) {
      tr.addEventListener('dragover', function (e) { e.preventDefault(); e.dataTransfer.dropEffect = 'move'; tr.classList.add('drop-target'); });
      tr.addEventListener('dragleave', function () { tr.classList.remove('drop-target'); });
      tr.addEventListener('drop', function (e) {
        e.preventDefault();
        tr.classList.remove('drop-target');
        var to = Array.prototype.indexOf.call(tbody.children, tr);
        if (dragFrom == null || to < 0 || dragFrom === to) return;
        var item = arr.splice(dragFrom, 1)[0];
        arr.splice(to, 0, item);
        dragFrom = null;
        rerender();
        publishToAdmin();          /* đổi thứ tự -> Admin đổi theo */
        toast('Cập nhật thứ tự thành công');
      });
    });
  }

