  var openStack = [];
  function openLayer(id, size) {
    var el = $(id);
    if (size) el.setAttribute('data-size', size);
    $('backdrop').classList.add('is-open');
    el.classList.add('is-open');
    openStack.push(id);
    var f = el.querySelector('input, select, textarea, button');
    if (f) f.focus();
  }
  function closeLayer(id) {
    var el = $(id);
    el.classList.remove('is-open');
    openStack = openStack.filter(function (x) { return x !== id; });
    if (!openStack.length) $('backdrop').classList.remove('is-open', 'is-clear');
    if (id === 'modalProducts') $('btnApps').setAttribute('aria-expanded', 'false');
  }
  document.querySelectorAll('[data-close]').forEach(function (b) {
    b.addEventListener('click', function () { closeLayer(b.getAttribute('data-close')); });
  });
  $('backdrop').addEventListener('click', function () {
    if (openStack.length) closeLayer(openStack[openStack.length - 1]);
  });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && openStack.length) closeLayer(openStack[openStack.length - 1]);
  });

  var toastTimer;
  function toast(msg, kind) {
    $('toastMsg').textContent = msg;
    $('toast').classList.toggle('is-error', kind === 'error');
    $('toast').classList.add('is-on');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(function () { $('toast').classList.remove('is-on'); }, 3000);
  }
  $('toastClose').addEventListener('click', function () {
    clearTimeout(toastTimer);
    $('toast').classList.remove('is-on');
  });

