<!DOCTYPE html>
<html lang="vi" data-theme="light">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>ezOne IMS — Quản lý cấu hình Quick setup</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet" />
<style>
  /* ============================================================
     EzOne Design Tokens — theo EzOne_Template_FrameScreen.md §1
     Màn hình: Quản lý cấu hình Quick setup (ezOne.Ims)
     Figma: Ab5baxXTVOpcz7Zaxh1Yhi — section [IMS]
     ============================================================ */
  :root {
    --theme-action-hover: #2F2B3D0F;
    --theme-action-selected: #2F2B3D14;
    --theme-divider: #2F2B3D1F;
    --theme-input-border: #2F2B3D38;
    --theme-text-primary: #2F2B3DE5;
    --theme-text-secondary: #2F2B3DB2;
    --theme-text-disabled: #2F2B3D66;

    --color-palette-primary-main: #186FF4;
    --color-palette-primary-dark: #1562D7;
    --color-palette-error-main: #FF4C51;

    --logo-ez: #00A2E1;        /* accent-3 — chữ "ez" */
    --logo-one: #004BA5;       /* accent-alt — chữ "One" */
    --logo-ims: #6E5040;       /* accent — chữ "IMS" + nền emblem (LogoEzoneIMS.md) */

    --misc-paper: #FFFFFF;
    --misc-body-bg: #F8F7FA;
    --misc-bg-white-text: #FFFFFF;
    --misc-avatar-bg: #EEEDF0;
    --misc-card-header: 4px;

    --border-radius-sm: 4px;
    --border-radius-md: 6px;
    --border-round: 500px;

    --padding-1: 4px; --padding-2: 8px; --padding-3: 12px; --padding-4: 16px;
    --gap-2: 8px; --gap-3: 12px;
    --text-size-md: 15px;

    --shadow-sm: 0px 2px 8px 0px rgba(47, 43, 61, 0.12);
    --shadow-md: 0px 3px 12px 0px rgba(47, 43, 61, 0.14);
    --shadow-rail: 0px 2px 4px 0px rgba(47, 43, 61, 0.12);

    --sidebar-width: 260px;
    --rail-width: 70px;
    --group-gap: 6px;
    --select-width: 300px;
    --field-px: 14px;
    --avatar-size: 38px;
    --icon-size: 22px;

    /* Bổ sung cho màn Ims (không có token tương đương — flagged) */
    --success-main: #28C76F;        /* Color/Success/success-500 */
    --success-soft: #28C76F14;      /* Opacity success-8 */
    --secondary-main: #808390;      /* Color/Secondary/secondary-500 */
    --secondary-soft: #80839014;    /* Opacity secondary-8 */
    --primary-soft: #186FF414;      /* Opacity primary-8 */
    --grey-light: #FAFAFA;          /* Misc/grey-light */
    --drawer-sm: 480px;             /* drawer nhóm thiết lập (Figma) */
    --drawer-md: 540px;             /* drawer bước thiết lập (Figma) */
    --drawer-lg: 975px;             /* drawer chi tiết nhóm (Figma) */
    --ctrl-h: 38px;                 /* chiều cao input/button */
  }

  * { box-sizing: border-box; }
  [hidden] { display: none !important; }
  html, body { height: 100%; }
  body {
    margin: 0;
    font-family: 'Roboto', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
    background: var(--misc-body-bg);
    color: var(--theme-text-primary);
    -webkit-font-smoothing: antialiased;
  }

  .app { display: flex; align-items: stretch; height: 100vh; background: var(--misc-body-bg); }

  /* ---------------- Sidebar (theo template §2–§4) ---------------- */
  .sidebar {
    display: flex; flex-direction: column;
    width: var(--sidebar-width); flex-shrink: 0; height: 100%;
    background: var(--misc-paper); box-shadow: var(--shadow-sm);
    overflow: hidden; z-index: 2; transition: width .22s ease;
  }
  .logo-row {
    display: flex; align-items: center; justify-content: space-between;
    padding: var(--padding-3) var(--padding-4) var(--padding-2);
    width: 100%; flex-shrink: 0;
  }
  .logo-btn {
    display: flex; align-items: center; gap: var(--gap-2);
    height: 48px; padding: 0; border: 0; background: transparent;
    cursor: pointer; color: inherit; font: inherit;
  }
  /* Logo phân hệ IMS — Figma node I0:16889;29065:66254 (155×48)
     emblem tròn nâu --logo-ims-emblem + wordmark "ezOne IMS" */
  .logo-mark {
    width: 32px; height: 32px; flex-shrink: 0;
    border-radius: var(--border-round);
    background: var(--logo-ims);   /* fallback nếu asset không tải được */
    overflow: hidden;
  }
  .logo-mark img, .logo-mark svg { display: block; width: 100%; height: 100%; }
  .logo-text { font-size: 21px; font-weight: 700; line-height: 1; letter-spacing: .2px; white-space: nowrap; }
  .logo-text .lg-ez { color: var(--logo-ez); }
  .logo-text .lg-one { color: var(--logo-one); }
  .logo-text .lg-ims { color: var(--logo-ims); }

  .pin-btn {
    display: inline-flex; align-items: center; justify-content: center;
    width: 20px; height: 20px; padding: 0; border: 0; background: transparent;
    color: var(--theme-text-secondary); cursor: pointer; border-radius: var(--border-radius-sm);
  }
  .pin-btn:hover { color: var(--theme-text-primary); }
  .pin-btn:focus-visible, .logo-btn:focus-visible { outline: 2px solid var(--color-palette-primary-main); outline-offset: 2px; }
  .pin-btn svg { display: block; width: 100%; height: 100%; }

  .menu-drawer { display: flex; flex-direction: column; flex: 1 0 0; min-height: 0; width: 100%; padding: 0 var(--padding-3); overflow: hidden; }
  .pages { display: flex; flex-direction: column; flex: 1 0 0; min-height: 0; padding-bottom: var(--padding-2); }
  .pages-scroll {
    display: flex; flex-direction: column; flex: 1 0 0; min-height: 0;
    gap: var(--padding-2); overflow-y: auto; overflow-x: hidden; padding-bottom: var(--padding-1);
  }
  .pages-scroll::-webkit-scrollbar { width: 6px; }
  .pages-scroll::-webkit-scrollbar-thumb { background: var(--theme-divider); border-radius: var(--border-round); }
  .pages-scroll { scrollbar-width: thin; scrollbar-color: var(--theme-divider) transparent; }

  .nav-group { display: flex; flex-direction: column; gap: var(--group-gap); width: 100%; flex-shrink: 0; }
  .nav-item {
    display: flex; align-items: center; gap: var(--gap-2);
    padding: var(--padding-2) var(--padding-3); border-radius: var(--border-radius-md);
    width: 100%; flex-shrink: 0; cursor: pointer; color: var(--theme-text-primary);
    background: transparent; border: 0; text-align: left; font: inherit;
  }
  .nav-item:hover { background: var(--theme-action-hover); }
  .nav-item:focus-visible { outline: 2px solid var(--color-palette-primary-main); outline-offset: -2px; }
  .nav-icon { width: var(--icon-size); height: var(--icon-size); flex-shrink: 0; color: var(--theme-text-primary); }
  .nav-icon svg { display: block; width: 100%; height: 100%; }
  .nav-label { flex: 1 0 0; min-width: 0; font-size: var(--text-size-md); line-height: 22px; word-break: break-word; color: inherit; }

  .nav-caret {
    display: inline-flex; align-items: center; justify-content: center;
    width: var(--icon-size); height: var(--icon-size); flex-shrink: 0;
    padding: 0; border: 0; background: transparent; color: var(--theme-text-secondary);
    cursor: pointer; border-radius: var(--border-radius-sm); transition: transform .18s ease, color .15s ease;
  }
  .nav-caret:hover { color: var(--theme-text-primary); }
  .nav-caret:focus-visible { outline: 2px solid var(--color-palette-primary-main); outline-offset: -2px; }
  .nav-caret svg { display: block; width: 18px; height: 18px; }
  .nav-group.is-closed .nav-caret { transform: rotate(-90deg); }
  .nav-children { display: flex; flex-direction: column; gap: var(--group-gap); width: 100%; }
  .nav-group.is-closed .nav-children { display: none; }

  .nav-child {
    display: flex; align-items: center; gap: var(--gap-2);
    padding: var(--padding-2) var(--padding-3); border-radius: var(--border-radius-md);
    width: 100%; flex-shrink: 0; cursor: pointer; color: var(--theme-text-primary);
  }
  .nav-child:hover { background: var(--theme-action-hover); }
  .nav-child:focus-visible { outline: 2px solid var(--color-palette-primary-main); outline-offset: -2px; }
  .nav-bullet {
    width: var(--icon-size); height: 12px; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center; color: var(--theme-text-secondary);
  }
  .nav-bullet svg { display: block; width: 12px; height: 12px; }
  .nav-child .nav-label { line-height: 22px; }
  .nav-child.is-selected { background: var(--color-palette-primary-main); }
  .nav-child.is-selected .nav-label, .nav-child.is-selected .nav-bullet { color: var(--misc-bg-white-text); }
  .nav-child.is-selected:hover { background: var(--color-palette-primary-dark); }

  .sidebar-foot {
    display: flex; align-items: center; justify-content: center; gap: 6px;
    padding: var(--padding-2); flex-shrink: 0;
    font-size: 11px; color: var(--theme-text-disabled);
    border-top: 1px solid var(--theme-divider);
  }
  .sidebar-foot b { color: var(--logo-one); font-weight: 500; }

  /* Rail thu gọn (§4) */
  .app.is-collapsed .sidebar { width: var(--rail-width); box-shadow: var(--shadow-rail); }
  .app.is-collapsed .logo-row { justify-content: center; padding: var(--padding-3) 0; height: 70px; }
  .app.is-collapsed .logo-text,
  .app.is-collapsed .pin-btn,
  .app.is-collapsed .nav-label,
  .app.is-collapsed .nav-caret,
  .app.is-collapsed .nav-children,
  .app.is-collapsed .sidebar-foot { display: none; }
  .app.is-collapsed .logo-btn { height: 48px; gap: 0; }
  .app.is-collapsed .logo-mark { width: 48px; height: 48px; }
  .app.is-collapsed .nav-item { justify-content: center; }
  .app.is-collapsed .nav-icon { color: var(--theme-text-secondary); }
  .app.is-collapsed .nav-item:hover .nav-icon { color: var(--theme-text-primary); }

  /* ---------------- Container + top nav ---------------- */
  .container { display: flex; flex-direction: column; flex: 1 0 0; min-width: 0; height: 100%; }
  .nav-wrap { display: flex; flex-direction: column; padding: var(--misc-card-header) var(--misc-card-header) 0; width: 100%; flex-shrink: 0; }
  .nav-header {
    display: flex; align-items: center; gap: var(--gap-2); width: 100%;
    padding: var(--padding-2) var(--padding-4);
    background: var(--misc-paper); border-radius: var(--border-radius-sm); box-shadow: var(--shadow-sm);
  }
  .actions { display: flex; flex: 1 0 0; min-width: 0; align-items: center; justify-content: flex-end; gap: var(--padding-3); }
  .select { width: var(--select-width); max-width: 100%; flex-shrink: 0; }
  .select-field {
    display: flex; align-items: center; gap: 10px; width: 100%;
    padding: var(--padding-2) var(--field-px);
    background: var(--misc-paper); border: 1px solid var(--theme-input-border);
    border-radius: var(--border-radius-md); cursor: pointer;
  }
  .select-field:hover { border-color: var(--theme-text-secondary); }
  .select-field:focus-visible { outline: 2px solid var(--color-palette-primary-main); outline-offset: -1px; }
  .select-value { flex: 1 0 0; min-width: 0; font-size: 14px; line-height: 22px; color: var(--theme-text-primary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .select-chevron { width: 16px; height: 16px; flex-shrink: 0; color: var(--theme-text-secondary); }
  .select-chevron svg { display: block; width: 100%; height: 100%; }

  .icon-btn {
    display: inline-flex; align-items: center; justify-content: center;
    padding: var(--padding-2); border-radius: var(--border-round); border: 0;
    background: transparent; color: var(--theme-text-secondary); cursor: pointer;
  }
  .icon-btn:hover { background: var(--theme-action-hover); color: var(--theme-text-primary); }
  .icon-btn:focus-visible { outline: 2px solid var(--color-palette-primary-main); outline-offset: -2px; }
  .icon-btn svg { display: block; width: var(--icon-size); height: var(--icon-size); }

  .tools { display: flex; align-items: center; gap: var(--padding-1); flex-shrink: 0; }
  .bell-wrap { position: relative; }
  .badge { position: absolute; top: 7px; right: 7px; width: 8px; height: 8px; border-radius: var(--border-round); background: var(--color-palette-error-main); border: 1.5px solid var(--misc-paper); }
  .avatar {
    width: var(--avatar-size); height: var(--avatar-size); flex-shrink: 0;
    border-radius: var(--border-round); background: var(--misc-avatar-bg);
    overflow: hidden; display: flex; align-items: center; justify-content: center;
  }
  .avatar img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .body { display: flex; flex-direction: column; flex: 1 0 0; min-height: 0; width: 100%; padding: var(--misc-card-header); }
  .card {
    flex: 1 0 0; min-height: 0; width: 100%;
    background: var(--misc-paper); border-radius: var(--border-radius-md); box-shadow: var(--shadow-md);
    display: flex; flex-direction: column; overflow: hidden;
  }

  /* ============================================================
     NỘI DUNG MÀN HÌNH — Quản lý cấu hình Quick setup
     ============================================================ */
  .page { display: flex; flex-direction: column; flex: 1 0 0; min-height: 0; padding: var(--padding-4); gap: var(--padding-4); }
  .page-title { margin: 0; font-size: 18px; font-weight: 500; line-height: 26px; color: var(--theme-text-primary); }

  /* --- Bộ lọc tìm kiếm --- */
  .filters { display: flex; align-items: flex-end; gap: var(--gap-3); flex-wrap: wrap; }
  .field { display: flex; flex-direction: column; gap: var(--padding-1); }
  .field-label { font-size: 13px; line-height: 18px; color: var(--theme-text-secondary); }
  .field-label .req { color: var(--color-palette-error-main); margin-left: 2px; }

  .input, .native-select {
    height: var(--ctrl-h); width: 100%;
    padding: 0 var(--field-px);
    font: inherit; font-size: 14px; color: var(--theme-text-primary);
    background: var(--misc-paper);
    border: 1px solid var(--theme-input-border); border-radius: var(--border-radius-md);
    outline: none;
  }
  .input::placeholder { color: var(--theme-text-disabled); }
  .input:hover, .native-select:hover { border-color: var(--theme-text-secondary); }
  .input:focus, .native-select:focus { border-color: var(--color-palette-primary-main); box-shadow: 0 0 0 3px var(--primary-soft); }
  .input.is-error { border-color: var(--color-palette-error-main); }
  .input.is-error:focus { box-shadow: 0 0 0 3px #FF4C5114; }
  textarea.input { height: auto; min-height: 76px; padding: var(--padding-2) var(--field-px); line-height: 20px; resize: vertical; }

  .input-search { position: relative; }
  .input-search .input { padding-left: 38px; }
  .input-search svg { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); width: 18px; height: 18px; color: var(--theme-text-disabled); pointer-events: none; }

  .err-msg { font-size: 12px; line-height: 16px; color: var(--color-palette-error-main); min-height: 0; }

  /* --- Buttons --- */
  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 6px;
    height: var(--ctrl-h); padding: 0 var(--padding-4);
    font: inherit; font-size: 14px; font-weight: 500;
    border-radius: var(--border-radius-md); border: 1px solid transparent;
    cursor: pointer; white-space: nowrap;
    transition: background .15s ease, border-color .15s ease;
  }
  .btn svg { width: 18px; height: 18px; flex-shrink: 0; }
  .btn-primary { background: var(--color-palette-primary-main); color: var(--misc-bg-white-text); }
  .btn-primary:hover { background: var(--color-palette-primary-dark); }
  .btn-outline { background: var(--misc-paper); color: var(--theme-text-primary); border-color: var(--theme-input-border); }
  .btn-outline:hover { border-color: var(--color-palette-primary-main); color: var(--color-palette-primary-main); }
  .btn-ghost { background: transparent; color: var(--theme-text-secondary); }
  .btn-ghost:hover { background: var(--theme-action-hover); color: var(--theme-text-primary); }
  .btn-danger { background: var(--color-palette-error-main); color: var(--misc-bg-white-text); }
  .btn-danger:hover { background: #E64449; }
  .btn:focus-visible { outline: 2px solid var(--color-palette-primary-main); outline-offset: 2px; }

  .toolbar { display: flex; align-items: center; justify-content: flex-end; gap: var(--gap-2); }

  /* --- Bảng dữ liệu --- */
  .table-wrap { flex: 1 0 0; min-height: 0; display: flex; flex-direction: column; border: 1px solid var(--theme-divider); border-radius: var(--border-radius-md); overflow: hidden; }
  .table-scroll { flex: 1 1 auto; min-height: 0; overflow: auto; }
  .table-scroll::-webkit-scrollbar { width: 8px; height: 8px; }
  .table-scroll::-webkit-scrollbar-thumb { background: var(--theme-input-border); border-radius: var(--border-round); }

  table.grid { width: 100%; border-collapse: collapse; font-size: 14px; }
  table.grid th, table.grid td { padding: var(--padding-2) var(--padding-3); text-align: left; white-space: nowrap; }
  table.grid thead th {
    position: sticky; top: 0; z-index: 1;
    background: var(--grey-light);
    font-size: 12px; font-weight: 500; letter-spacing: .3px; text-transform: uppercase;
    color: var(--theme-text-secondary);
    border-bottom: 1px solid var(--theme-divider);
  }
  table.grid tbody tr { border-bottom: 1px solid var(--theme-divider); cursor: pointer; }
  table.grid tbody tr:last-child { border-bottom: 0; }
  table.grid tbody tr:hover { background: var(--primary-soft); }
  table.grid tbody tr.is-dragging { opacity: .4; }
  table.grid tbody tr.drop-target td { box-shadow: inset 0 2px 0 0 var(--color-palette-primary-main); }
  td.ellip, th.ellip { max-width: 260px; overflow: hidden; text-overflow: ellipsis; }

  /* Cột Tác vụ ghim phải (Figma: frame "ColumnAction" tách riêng) */
  table.grid th.col-action, table.grid td.col-action {
    position: sticky; right: 0; z-index: 2;
    background: var(--misc-paper);
    box-shadow: inset 1px 0 0 0 var(--theme-divider);
  }
  table.grid thead th.col-action { z-index: 3; background: var(--grey-light); }
  table.grid tbody tr:hover td.col-action { background: #F1F5FE; }
  /* Cột Tác vụ gọn: chỉ vừa 2 icon 28px + gap (Figma ColumnAction) */
  table.grid th.col-action, table.grid td.col-action {
    width: 84px; min-width: 84px; padding-left: var(--padding-2); padding-right: var(--padding-2);
  }
  table.grid td.col-action .row-actions { justify-content: center; }

  .drag-cell { width: 40px; color: var(--theme-text-disabled); cursor: grab; }
  .drag-cell svg { width: 16px; height: 16px; display: block; }
  .drag-cell:active { cursor: grabbing; }
  .num-cell { width: 56px; color: var(--theme-text-secondary); }

  .badge-status {
    display: inline-flex; align-items: center;
    padding: 2px var(--padding-2); border-radius: var(--border-radius-sm);
    font-size: 12px; line-height: 18px; font-weight: 500; white-space: nowrap;
  }
  .badge-status.is-active { background: var(--success-soft); color: var(--success-main); }
  .badge-status.is-inactive { background: var(--secondary-soft); color: var(--secondary-main); }

  .row-actions { display: flex; align-items: center; gap: var(--padding-1); }
  .act-btn {
    display: inline-flex; align-items: center; justify-content: center;
    width: 28px; height: 28px; padding: 0; border: 0; border-radius: var(--border-radius-sm);
    background: transparent; cursor: pointer; color: var(--theme-text-secondary);
  }
  .act-btn svg { width: 17px; height: 17px; display: block; }
  .act-btn.edit:hover { background: var(--primary-soft); color: var(--color-palette-primary-main); }
  .act-btn.del { color: var(--color-palette-error-main); }
  .act-btn.del:hover { background: #FF4C5114; }
  .act-btn:focus-visible { outline: 2px solid var(--color-palette-primary-main); outline-offset: 1px; }

  .empty-row td { text-align: center; color: var(--theme-text-disabled); padding: var(--padding-8, 32px) var(--padding-3); cursor: default; }

  /* --- Phân trang --- */
  .pagination {
    display: flex; align-items: center; justify-content: space-between; gap: var(--gap-3);
    flex-wrap: wrap; flex-shrink: 0;
    padding: var(--padding-2) var(--padding-3);
    border-top: 1px solid var(--theme-divider); background: var(--misc-paper);
  }
  .pg-left, .pg-right { display: flex; align-items: center; gap: var(--gap-2); }
  .pg-text { font-size: 13px; color: var(--theme-text-secondary); }
  .pg-size { height: 32px; padding: 0 var(--padding-2); font: inherit; font-size: 13px; border: 1px solid var(--theme-input-border); border-radius: var(--border-radius-md); background: var(--misc-paper); color: var(--theme-text-primary); }
  .pg-btn {
    min-width: 30px; height: 30px; padding: 0 6px;
    display: inline-flex; align-items: center; justify-content: center;
    font: inherit; font-size: 13px;
    border: 1px solid var(--theme-input-border); border-radius: var(--border-radius-md);
    background: var(--misc-paper); color: var(--theme-text-secondary); cursor: pointer;
  }
  .pg-btn:hover:not(:disabled) { border-color: var(--color-palette-primary-main); color: var(--color-palette-primary-main); }
  .pg-btn.is-active { background: var(--color-palette-primary-main); border-color: var(--color-palette-primary-main); color: var(--misc-bg-white-text); }
  .pg-btn:disabled { opacity: .4; pointer-events: none; }
  .pg-btn:focus-visible { outline: 2px solid var(--color-palette-primary-main); outline-offset: 1px; }
  .pg-btn svg { width: 14px; height: 14px; }

  /* ---------------- Drawer (Figma: form dạng slidebar phải) ---------------- */
  .backdrop {
    position: fixed; inset: 0; background: rgba(47, 43, 61, 0.5);
    opacity: 0; pointer-events: none; transition: opacity .22s ease; z-index: 40;
  }
  .backdrop.is-open { opacity: 1; pointer-events: auto; }
  /* popover (dialog module): chỉ bắt click-outside, không làm tối nền */
  .backdrop.is-clear { background: transparent; }

  .drawer {
    position: fixed; top: 0; right: 0; bottom: 0;
    width: var(--drawer-sm); max-width: 100vw;
    background: var(--misc-paper);
    box-shadow: -4px 0 24px rgba(47, 43, 61, 0.18);
    display: flex; flex-direction: column;
    transform: translateX(100%); transition: transform .26s cubic-bezier(.2,.8,.3,1);
    z-index: 50;
  }
  .drawer.is-open { transform: translateX(0); }
  .drawer[data-size="md"] { width: var(--drawer-md); }
  .drawer[data-size="lg"] { width: var(--drawer-lg); }

  .drawer-head {
    display: flex; align-items: center; gap: var(--gap-3);
    padding: var(--padding-4); border-bottom: 1px solid var(--theme-divider); flex-shrink: 0;
  }
  .drawer-title { flex: 1 0 0; margin: 0; font-size: 16px; font-weight: 500; line-height: 24px; color: var(--theme-text-primary); }
  .drawer-body {
    flex: 1 1 auto; min-height: 0; overflow-y: auto;
    padding: var(--padding-4); display: flex; flex-direction: column; gap: var(--padding-4);
  }
  .drawer-body::-webkit-scrollbar { width: 6px; }
  .drawer-body::-webkit-scrollbar-thumb { background: var(--theme-divider); border-radius: var(--border-round); }
  .drawer-foot {
    display: flex; align-items: center; justify-content: flex-end; gap: var(--gap-2);
    padding: var(--padding-3) var(--padding-4);
    border-top: 1px solid var(--theme-divider); background: var(--misc-paper); flex-shrink: 0;
  }
  .close-btn {
    display: inline-flex; align-items: center; justify-content: center;
    width: 32px; height: 32px; flex-shrink: 0; border: 0; background: transparent;
    border-radius: var(--border-round); color: var(--theme-text-secondary); cursor: pointer;
  }
  .close-btn:hover { background: var(--theme-action-hover); color: var(--theme-text-primary); }
  .close-btn:focus-visible { outline: 2px solid var(--color-palette-primary-main); outline-offset: -2px; }
  .close-btn svg { width: 20px; height: 20px; display: block; }

  /* Icon song ngữ trên label — Figma "Two Languages" (0:6153): 3 icon 15×15, gap 4px */
  .lang-flags { display: inline-flex; align-items: center; gap: 4px; margin-left: auto; flex-shrink: 0; }
  .lang-flag {
    width: 15px; height: 15px; flex-shrink: 0;
    border: 0; padding: 0; cursor: pointer;
    border-radius: 2px; overflow: hidden;
    opacity: .5; transition: opacity .15s ease;
    display: inline-flex; align-items: center; justify-content: center;
    background: transparent;
  }
  .lang-flag svg { display: block; width: 15px; height: 15px; }
  .lang-flag.is-on { opacity: 1; }
  .lang-flag:hover { opacity: .85; }
  .lang-flag.is-on:hover { opacity: 1; }
  .lang-flag:focus-visible { outline: 2px solid var(--color-palette-primary-main); outline-offset: 1px; opacity: 1; }
  /* label + cụm icon nằm cùng hàng, label chiếm phần còn lại (Figma) */
  .label-row { display: flex; align-items: center; gap: 4px; width: 100%; }
  .label-row .field-label { flex: 1 0 0; min-width: 0; }

  /* Toggle */
  .switch-row { display: flex; align-items: center; gap: var(--gap-2); }
  .switch {
    position: relative; flex-shrink: 0; width: 38px; height: 20px; padding: 0; border: 0;
    border-radius: var(--border-round); background: var(--theme-input-border);
    cursor: pointer; transition: background .18s ease;
  }
  .switch::after {
    content: ""; position: absolute; top: 2px; left: 2px; width: 16px; height: 16px;
    border-radius: var(--border-round); background: var(--misc-bg-white-text);
    box-shadow: 0 1px 3px rgba(47,43,61,.25); transition: transform .18s ease;
  }
  .switch[aria-checked="true"] { background: var(--color-palette-primary-main); }
  .switch[aria-checked="true"]::after { transform: translateX(18px); }
  .switch:focus-visible { outline: 2px solid var(--color-palette-primary-main); outline-offset: 2px; }
  .switch-label { font-size: 14px; color: var(--theme-text-primary); }

  /* Input số có nút ▲▼ */
  .num-wrap { position: relative; }
  .num-wrap .input { padding-right: 34px; }
  .num-spin { position: absolute; right: 6px; top: 50%; transform: translateY(-50%); display: flex; flex-direction: column; gap: 1px; }
  .num-spin button {
    width: 20px; height: 14px; padding: 0; border: 0; background: transparent;
    color: var(--theme-text-secondary); cursor: pointer; display: flex; align-items: center; justify-content: center;
  }
  .num-spin button:hover { color: var(--color-palette-primary-main); }
  .num-spin svg { width: 12px; height: 12px; }

  /* Khối thông tin chung read-only (drawer chi tiết) */
  .section-title { font-size: 14px; font-weight: 500; color: var(--theme-text-primary); margin: 0 0 var(--padding-3); }
  .info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--padding-3) var(--padding-4); }
  .info-item { display: flex; align-items: baseline; gap: 6px; font-size: 14px; }
  .info-key { color: var(--theme-text-secondary); }
  .info-val { color: var(--theme-text-primary); font-weight: 500; }
  .detail-block { padding-bottom: var(--padding-4); border-bottom: 1px solid var(--theme-divider); }
  .steps-head { display: flex; align-items: center; gap: var(--gap-2); margin-bottom: var(--padding-3); }
  .steps-head .section-title { flex: 1 0 0; margin: 0; }

  /* Panel chọn cột hiển thị */
  .cols-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--padding-2) var(--padding-4); }
  .chk-row { display: flex; align-items: center; gap: var(--gap-2); font-size: 14px; cursor: pointer; padding: var(--padding-1) 0; }
  .chk-row input { width: 16px; height: 16px; accent-color: var(--color-palette-primary-main); cursor: pointer; }
  .chk-row input:disabled { cursor: not-allowed; }
  .chk-row.is-locked { color: var(--theme-text-disabled); cursor: not-allowed; }

  /* Modal xác nhận xóa (Figma: dialog 480×186 giữa màn) */
  .modal {
    position: fixed; z-index: 60; top: 50%; left: 50%; transform: translate(-50%, -50%) scale(.97);
    width: 480px; max-width: calc(100vw - 32px);
    background: var(--misc-paper); border-radius: var(--border-radius-md);
    box-shadow: 0 12px 40px rgba(47, 43, 61, 0.22);
    display: none; flex-direction: column; overflow: hidden;
  }
  .modal.is-open { display: flex; animation: mpop .16s ease forwards; }
  @keyframes mpop { to { transform: translate(-50%, -50%) scale(1); } }
  .modal-head { display: flex; align-items: center; gap: var(--gap-3); padding: var(--padding-4); }
  .modal-title { flex: 1 0 0; margin: 0; font-size: 16px; font-weight: 500; color: var(--theme-text-primary); }
  .modal-body { padding: 0 var(--padding-4) var(--padding-4); font-size: 14px; line-height: 22px; color: var(--theme-text-secondary); }
  .modal-foot { display: flex; align-items: center; justify-content: flex-end; gap: var(--gap-2); padding: var(--padding-3) var(--padding-4); border-top: 1px solid var(--theme-divider); }

  /* Toast — Figma "Alert" (0:17379): 320×54, nền đặc, chữ trắng, góc trên phải */
  .toast {
    position: fixed; top: 36px; right: 24px;
    z-index: 70;
    display: flex; align-items: center; gap: var(--padding-3);
    width: 320px; min-height: 54px;
    padding: var(--padding-2) var(--padding-3);
    border-radius: var(--border-radius-md);
    background: var(--success-main);
    box-shadow: var(--shadow-md);
    font-size: 14px; line-height: 20px; color: var(--misc-bg-white-text);
    opacity: 0; transform: translateY(-12px);
    pointer-events: none; transition: opacity .22s ease, transform .22s ease;
  }
  .toast.is-on { opacity: 1; transform: translateY(0); pointer-events: auto; }
  .toast.is-error { background: var(--color-palette-error-main); }
  .toast-ico {
    flex-shrink: 0; width: 34px; height: 34px;
    display: inline-flex; align-items: center; justify-content: center;
    border-radius: var(--border-radius-md);
    background: var(--misc-bg-white-text);
  }
  .toast-ico svg { width: 20px; height: 20px; display: block; color: var(--success-main); }
  .toast.is-error .toast-ico svg { color: var(--color-palette-error-main); }
  .toast-msg { flex: 1 0 0; min-width: 0; }
  .toast-close {
    flex-shrink: 0; width: 24px; height: 24px; padding: 0; border: 0;
    display: inline-flex; align-items: center; justify-content: center;
    background: transparent; color: var(--misc-bg-white-text);
    cursor: pointer; border-radius: var(--border-radius-sm); opacity: .85;
  }
  .toast-close:hover { opacity: 1; background: rgba(255,255,255,.16); }
  .toast-close:focus-visible { outline: 2px solid var(--misc-bg-white-text); outline-offset: 1px; }
  .toast-close svg { width: 16px; height: 16px; display: block; }

  /* ---------- Dialog chọn module — Figma "EzOne Products" (110:4547) 650×500
       Hiển thị dạng popover neo ngay DƯỚI nút Ứng dụng trên header. ---------- */
  .modal.modal-products {
    width: 650px;
    max-height: min(500px, calc(100vh - 90px));
    top: auto; left: auto; transform: none;       /* huỷ canh giữa của .modal */
    transform-origin: top right;
  }
  .modal.modal-products.is-open { animation: prodPop .16s cubic-bezier(.2,.8,.3,1); }
  @keyframes prodPop {
    from { opacity: 0; transform: translateY(-6px) scale(.985); }
    to   { opacity: 1; transform: none; }
  }
  .prod-head {
    display: flex; align-items: center; gap: var(--padding-3);
    padding: var(--padding-4); flex-shrink: 0;
    border-bottom: 1px solid var(--theme-divider);
  }
  .prod-title { flex: 1 0 0; margin: 0; font-size: 18px; font-weight: 500; line-height: 28px; color: var(--theme-text-primary); }
  .prod-search { position: relative; width: 320px; flex-shrink: 0; }
  .prod-search .input { height: 30px; padding-left: 34px; font-size: 13px; }
  .prod-search svg { position: absolute; left: 10px; top: 50%; transform: translateY(-50%); width: 16px; height: 16px; color: var(--theme-text-disabled); pointer-events: none; }

  .prod-body {
    flex: 1 1 auto; min-height: 0; overflow-y: auto;
    padding: var(--padding-3); display: flex; flex-direction: column; gap: var(--padding-3);
  }
  .prod-body::-webkit-scrollbar { width: 8px; }
  .prod-body::-webkit-scrollbar-thumb { background: var(--theme-input-border); border-radius: var(--border-round); }

  .prod-group { display: flex; flex-direction: column; }
  .prod-group + .prod-group { border-top: 1px solid var(--theme-divider); padding-top: var(--padding-3); }
  .prod-g-head {
    display: flex; align-items: center; gap: var(--padding-1);
    width: 100%; padding: 0 0 var(--padding-2); border: 0; background: transparent;
    font: inherit; font-size: 15px; font-weight: 500; color: var(--theme-text-primary);
    cursor: pointer; text-align: left;
  }
  .prod-g-head:focus-visible { outline: 2px solid var(--color-palette-primary-main); outline-offset: 2px; }
  .prod-caret { width: 20px; height: 20px; flex-shrink: 0; color: var(--theme-text-secondary); transition: transform .18s ease; }
  .prod-caret svg { width: 100%; height: 100%; display: block; }
  .prod-group.is-closed .prod-caret { transform: rotate(-90deg); }
  .prod-group.is-closed .prod-grid { display: none; }

  .prod-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--padding-2); }
  .prod-item {
    display: flex; flex-direction: column; align-items: center; gap: 6px;
    padding: var(--padding-3) var(--padding-2);
    border: 0; border-radius: var(--border-radius-md);
    background: transparent; cursor: pointer; font: inherit; text-align: center;
    transition: background .15s ease;
  }
  .prod-item:hover { background: var(--primary-soft); }
  .prod-item:focus-visible { outline: 2px solid var(--color-palette-primary-main); outline-offset: -2px; }
  .prod-ico {
    width: 48px; height: 48px; flex-shrink: 0; border-radius: var(--border-round);
    display: inline-flex; align-items: center; justify-content: center;
    color: var(--misc-bg-white-text);
  }
  .prod-ico svg { width: 26px; height: 26px; display: block; }
  .prod-name { font-size: 13px; font-weight: 500; line-height: 20px; color: var(--theme-text-primary); }
  .prod-desc { font-size: 12px; line-height: 18px; color: var(--theme-text-disabled); }
  .prod-empty { padding: var(--padding-4); text-align: center; font-size: 13px; color: var(--theme-text-disabled); }

  /* ---------------- Responsive (§7) ---------------- */
  @media (max-width: 768px) {
    :root { --sidebar-width: 240px; --select-width: 260px; }
    .info-grid, .cols-grid { grid-template-columns: 1fr; }
    .drawer[data-size="lg"] { width: 100vw; }
  }
  @media (max-width: 600px) {
    :root { --select-width: 180px; }
    .actions { gap: var(--padding-2); }
    .filters > * { width: 100%; }
    .drawer { width: 100vw; }
  }
</style>
